<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Details</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Edit Post</h1>
    <form method="post" action="/posts/<%=post.id%>/?_method=PATCH">
        <div>
            <h3><b>ID:</b><%=post.id%></h3>
            <h3>USER:@<%=post.username%></h3>
        </div>
        <textarea rows="15" cols="50" name="content"><%= post.content%></textarea>
        <br>
        <button type="submit">Save</button>
    </form>
</body>
</html>